// AWS Batch (Fargate) config for nf-core/airrflow
// Mirrors nf-immcantation aws_batch profile: same account, queue, Tower workspace.

process.executor = 'awsbatch'
process.queue    = 'nf-immcantation-fargate'

aws.region                     = 'us-east-1'
aws.batch.platformType         = 'fargate'
aws.batch.executionRole        = 'arn:aws:iam::035260058162:role/ecsTaskExecutionRole'
aws.batch.jobRole              = 'arn:aws:iam::035260058162:role/nextflow-job-role'
aws.batch.maxParallelTransfers = 16
aws.batch.maxTransferAttempts  = 3
aws.batch.maxSpotAttempts      = 3

tower {
    enabled     = true
    accessToken = System.getenv('TOWER_ACCESS_TOKEN')
    workspaceId = '99735324731614'
}

workDir = 's3://imm-test-bucket-allovista/airrflow/work'

docker.enabled = true

// Wave augments public containers with s5cmd for S3 staging.
// nf-immcantation bakes s5cmd into custom ECR images; airrflow uses
// stock Biocontainers that lack it.
wave.enabled   = true
fusion.enabled = false

process {
    // Integer.MAX_VALUE = no exit code, e.g. Fargate Spot reclaim ("Your Spot Task was interrupted")
    errorStrategy = { task.exitStatus in [1, 2, 137, 139, 143, Integer.MAX_VALUE] ? 'retry' : 'finish' }
    maxRetries    = 5
    disk          = 200.GB

    // Fargate vCPU tiers: 0.25, 0.5, 1, 2, 4, 8, 16
    // Memory tied to vCPU tier in fixed increments.
    // Same sizing as nf-immcantation bulletproof profile.
    withLabel: process_single { cpus = 1;  memory = 6.GB  }
    withLabel: process_low    { cpus = 2;  memory = 12.GB }
    withLabel: process_medium { cpus = 8;  memory = 36.GB }
    withLabel: process_high   { cpus = 16; memory = 72.GB }

    withLabel: process_long_parallelized { cpus = 16; memory = 72.GB }
}
